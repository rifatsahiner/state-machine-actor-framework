
prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: uOS
Description: Hierarchical state-machine framework C++ library.
Version: @PROJECT_VERSION@
URL: https://github.com/rifatsahiner/state-machine-framework
Requires.private: @UOS_PC_REQUIRES_PRIVATE@
Libs: -L${libdir} -luOS -pthread
Libs.private: @UOS_PC_LIBS_PRIVATE@
Cflags: -I${includedir}/uOS -I${includedir} @UOS_PC_EXTRA_CFLAGS@