@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Find required external dependencies (system or otherwise)
find_dependency(Threads REQUIRED)
find_dependency(fmt 11.1)

include("${CMAKE_CURRENT_LIST_DIR}/uOSTargets.cmake")
add_library(uOS::cli ALIAS uOS::uOS_cli)
add_library(uOS::json ALIAS uOS::uOS_json)
check_required_components(uOS)
